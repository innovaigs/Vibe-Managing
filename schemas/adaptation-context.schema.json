{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://vibe-managing.local/schemas/adaptation-context.schema.json",
  "title": "Vibe Managing Adaptation Context",
  "type": "object",
  "required": ["primary_archetype", "industry_profiles", "business_model_profiles", "lifecycle_stage", "functional_maturity", "jurisdictions", "regulatory_intensity", "confidence"],
  "properties": {
    "primary_archetype": {"type": "string", "minLength": 1},
    "secondary_archetypes": {"type": "array", "items": {"type": "string"}, "uniqueItems": true},
    "industry_profiles": {"type": "array", "minItems": 1, "items": {"type": "object", "required": ["id", "version"], "properties": {"id": {"type": "string"}, "version": {"type": "string"}, "verified_at": {"type": ["string", "null"], "format": "date-time"}, "overrides": {"type": "array", "items": {"type": "object"}}}}},
    "business_model_profiles": {"type": "array", "minItems": 1, "items": {"type": "object", "required": ["id", "revenue_share"], "properties": {"id": {"type": "string"}, "revenue_share": {"type": "number", "minimum": 0, "maximum": 1}, "economic_unit": {"type": ["string", "null"]}}}},
    "lifecycle_stage": {"enum": ["formation", "validation", "repeatability", "scaling", "mature", "renewal", "decline", "exit"]},
    "functional_maturity": {"type": "object", "additionalProperties": {"type": "integer", "minimum": 0, "maximum": 5}},
    "jurisdictions": {"type": "array", "items": {"type": "object", "required": ["country", "activities"], "properties": {"country": {"type": "string"}, "region": {"type": ["string", "null"]}, "activities": {"type": "array", "items": {"type": "string"}}}}},
    "regulatory_intensity": {"enum": ["low", "moderate", "high", "critical"]},
    "metric_overrides": {"type": "array", "items": {"type": "object"}},
    "routing_overrides": {"type": "array", "items": {"type": "object"}},
    "confidence": {"type": "number", "minimum": 0, "maximum": 1},
    "as_of": {"type": "string", "format": "date-time"}
  },
  "additionalProperties": false
}
